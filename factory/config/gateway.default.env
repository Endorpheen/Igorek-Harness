MODE=local
FACTORY_LOG_FORMAT=pretty
FACTORY_LOG_LEVEL=info

FACTORY_TELEGRAM_ENABLED=true
FACTORY_TELEGRAM_ALLOWED_CHAT_IDS=
FACTORY_TELEGRAM_WORKDIR=.
FACTORY_TELEGRAM_POLL_TIMEOUT_S=30
FACTORY_TELEGRAM_AUTO_APPROVE=true
FACTORY_TELEGRAM_AUTO_APPROVE_SCOPE=session
FACTORY_TELEGRAM_RICH_MESSAGES=true

# Additional profiles for which the `igorek-factory gateway` spins up a separate worker process.
# worker (comma-separated). The active runtime profile is always served.
# Worker processes only pick up tasks for their own profile, so this list represents parallel queues.
# queues: `FACTORY_WORKER_PROFILES=cc-wally,cc-glm`. Empty/undefined — only
# active profile. Values like `off/0/no/false/disabled/none` disable the entire list entirely.
# Unknown profile name is silently skipped; stack does not crash.
# FACTORY_WORKER_PROFILES=

FACTORY_BOLTBOOK_HEARTBEAT_ENABLED=true
FACTORY_BOLTBOOK_HEARTBEAT_LOOP_INTERVAL_S=60
FACTORY_BOLTBOOK_HEARTBEAT_INTERVAL_S=1200
FACTORY_BOLTBOOK_HEARTBEAT_FEED_LIMIT=15
FACTORY_BOLTBOOK_HEARTBEAT_FEED_SORT=new

FACTORY_BOLTBOOK_AUTONOMOUS_COMMENTS_ENABLED=true
FACTORY_BOLTBOOK_AUTONOMOUS_POSTS_ENABLED=true
FACTORY_BOLTBOOK_AUTONOMOUS_POLICY=custom
FACTORY_BOLTBOOK_AUTONOMOUS_POST_SUBMOLT=general
FACTORY_BOLTBOOK_AUTONOMOUS_MIN_SCORE=4
FACTORY_BOLTBOOK_AUTONOMOUS_MAX_COMMENTS_PER_HOUR=1
FACTORY_BOLTBOOK_AUTONOMOUS_MAX_COMMENTS_PER_DAY=4
FACTORY_BOLTBOOK_AUTONOMOUS_OWN_POST_MAX_COMMENTS_PER_HOUR=1
FACTORY_BOLTBOOK_AUTONOMOUS_POST_TIMEOUT_S=240
FACTORY_BOLTBOOK_AUTONOMOUS_POST_COOLDOWN_S=86400
FACTORY_BOLTBOOK_AUTONOMOUS_POST_WINDOW_S=86400
FACTORY_BOLTBOOK_AUTONOMOUS_POST_MAX_PER_WINDOW=1

FACTORY_SESSION_EMBEDDINGS_ENABLED=auto
FACTORY_SESSION_EMBEDDINGS_HOST=127.0.0.1
FACTORY_SESSION_EMBEDDINGS_PORT=8022
FACTORY_SESSION_EMBEDDINGS_MODEL=jina-embeddings-v5-text-nano-retrieval

# Skills directories (colon-separated). First dir is writable, rest are read-only.
# AGENTFACTORY_SKILLS_DIRS=/path/writable:/path/readonly1:/path/readonly2
# Legacy single-dir env var (still supported):
# AGENTFACTORY_SKILLS_PATH=/path/to/skills

# Bash sandbox (bubblewrap). Default is ON: leaving this unset keeps the sandbox
# enabled. Values: on | off | observe. `off` is the operator disable switch and
# falls back to the legacy unsandboxed shell; `observe` runs the wrapper but
# still executes unsandboxed. Do NOT set this to off by default.
# Writes are confined to the workdir + Obsidian vault + IGOREK_BASH_WRITE_ROOTS
# (and IGOREK_BASH_SANDBOX_RW); reads and network stay unrestricted.
# IGOREK_BASH_SANDBOX=on
#
# Reinstallation of the agent's own package via the command (`uv tool install --force --reinstall .`).
# Requires writing to three UV directories: cache (~/.cache/uv), the tools root directory.
# (~/.local/share/uv/tools) and the shim script directory (~/.local/bin). These directories are added,
# automatically added to allowed roots (env var `IGOREK_BASH_TOOL_ROOTS`: `off` — does not, otherwise —
# add paths; paths are taken from `UV_CACHE_DIR` /
# `UV_TOOL_DIR` / `UV_TOOL_BIN_DIR`, then `XDG_*` directories, then default home paths).
# The remaining contents of the `$HOME` directory (including `.ssh`, configuration files, other projects, `/etc`, and `/usr`) remain read-only.
# IGOREK_BASH_TOOL_ROOTS=off
#
# Self-update split (IGOREK_ISOLATION_MODE=kvm, planned task 21): occurs inside the guest VM
# The same update process only affects the guest environment; UV root paths are resolved.
# Runs in the guest environment's environment (HOME=/home/agent), stored in a single-use qcow2 overlay and
# are deleted with the VM. Host UV roots (~/.cache/uv, ~/.local/share/uv/tools,
# ~/.local/bin) are not exported to the guest: the only exported directory is the working directory.
# The resolver workspace rejects if its path crosses the host's UV root directory.
# (`export_contains_host_uv_root`). Host runtime updates are only possible via
# Typed broker operation `runtime.update` (approval + audit), not via
# guest shell. Code and checks: factory/core/isolation/self_update.py,
# tests/test_isolation_self_update.py.

FACTORY_SMART_ROUTING_ENABLED=false
FACTORY_SMART_ROUTING_STRONG_PROVIDER=openrouter
FACTORY_SMART_ROUTING_STRONG_MODEL=qwen/qwen3.6-plus

FACTORY_VAULT_ENABLED=false
FACTORY_VAULT_SERVICES=
FACTORY_VAULT_AGENT=cc-backend
FACTORY_VAULT_TTL_SECONDS=900

# Realtime voice (OpenAI Realtime via WebRTC). The key is read from Igorek Vault.
# (the `openai` service) in the mobile bridge; the frontend never receives the key, and SDP
# Our server acts as a relay; media streams directly between the browser and OpenAI.
# IGOREK_REALTIME_ENABLED=1
# IGOREK_REALTIME_TIER=mini              # mini (low latency) | full
# IGOREK_REALTIME_MODEL=                 # explicit model override
# IGOREK_REALTIME_VOICE=marin
# IGOREK_REALTIME_TTL_S=600

MCP_SERVERS=fal_image,xsearch,coingecko,tavily,openrouter,grep_app
MCP_FAL_IMAGE_COMMAND=python3
MCP_FAL_IMAGE_ARGS=factory/mcp_servers/fal_image_server.py
MCP_FAL_IMAGE_ENV_FAL_IMAGE_MODEL=openai/gpt-image-2
MCP_FAL_IMAGE_ENV_FAL_IMAGE_SIZE=landscape_4_3
MCP_FAL_IMAGE_ENV_FAL_IMAGE_QUALITY=low
MCP_FAL_IMAGE_ENV_FAL_IMAGE_NUM_IMAGES=1
MCP_FAL_IMAGE_ENV_FAL_IMAGE_OUTPUT_FORMAT=png
MCP_FAL_IMAGE_ENV_FAL_IMAGE_SYNC_MODE=false
MCP_XSEARCH_COMMAND=python3
MCP_XSEARCH_ARGS=factory/mcp_servers/xsearch_server.py
XSEARCH_BEARER_TOKEN=
MCP_GREP_APP_COMMAND=node
MCP_GREP_APP_ARGS=factory/mcp_servers/grep_app_server.mjs
MCP_COINGECKO_COMMAND=python3
MCP_COINGECKO_ARGS=factory/mcp_servers/coingecko_server.py
MCP_TAVILY_COMMAND=python3
MCP_TAVILY_ARGS=factory/mcp_servers/tavily_server.py
MCP_OPENROUTER_COMMAND=python3
MCP_OPENROUTER_ARGS=factory/mcp_servers/openrouter_server.py
# chat-send tool is BILLABLE — disabled by default for safety.
# Set OPENROUTER_CHAT_SEND_ENABLED=true to enable.
OPENROUTER_CHAT_SEND_ENABLED=false

# Isolation via KVM; provider authentication injection on the host (todo plan 18).
# Host proxy adds Authorization headers, so guest environment does not require it.
# Provider token; guest environment scans reject any token in guest environment variables.
# Values: `auto` — injection for providers where it is implemented (Wally),
# others — documented fallback (ephemeral Vault environment on the host);
# `proxy` — require injection; `ephemeral_env` — mandatory fallback.
# Value not set — mechanism disabled (behavior as before).
# Until the host-local route for the guest to the proxy (todo 17) is ready, do not enable:
# Guest will not reach the proxy, and the task will fail with a clear error (fail-closed).
# In this case, the key does not belong to the guest.
# IGOREK_ISOLATION_EGRESS_AUTH=auto
# IGOREK_ISOLATION_EGRESS_AUTH_BIND=127.0.0.1:0
# IGOREK_ISOLATION_EGRESS_AUTH_GUEST_HOST=10.0.2.2

# Optional repository-scoped Git smart HTTP gateway for KVM sessions.
# Host operator grants only pinned IP URLs; push defaults to false.
# Credentials stay in host Git credential helpers, never in this setting.
# Main PC example (Mini PC must configure its own repository address):
# IGOREK_ISOLATION_GIT_REPOSITORIES=[{"url":"https://git.example.test/owner/project","push":true}]
IGOREK_ISOLATION_GIT_REPOSITORIES=

# Main PC/Mini PC: opt in locally to workspace APK delivery to the fixed owner.
IGOREK_ISOLATION_APK_DELIVERY=off
