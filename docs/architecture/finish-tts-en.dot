digraph release {
graph [rankdir=TB,bgcolor="white",pad="0.4",fontname="DejaVu Sans",labelloc=t,fontsize=22,label="Normal completion restored; message speech retained"];
node [shape=box,style="rounded,filled",fillcolor="#eef5e9",color="#527244",fontname="DejaVu Sans",fontsize=13,margin="0.15"];
n0 [label="Before: mandatory completion signal"];
n1 [label="Valid ordinary answer rejected / retried"];
n2 [label="Final 0.2.42: ordinary provider response"];
n3 [label="Tagged reasoning → reasoning channel"];
n4 [label="Final text → chat and task completion"];
n5 [label="Real tools → existing tool loop"];
n6 [label="Permissions and required-artifact checks retained"];
n7 [label="Owner TTS settings: URL, model, voice"];
n8 [label="Visible button → served player → Desktop IPC"];
n9 [label="Configured TTS → local Blob WAV → playback"];
n10 [label="Stop cancels request/audio; no autoplay"];
n0->n1; n1->n2 [style=dashed]; n2->n3; n2->n4; n2->n5; n5->n4; n4->n6 [style=dotted]; n7->n8; n8->n9; n9->n10;
}
