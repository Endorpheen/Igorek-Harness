digraph settings {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.7", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4e7", color="#527244", fontname="DejaVu Sans", margin="0.15"];
  edge [color="#527244", fontname="DejaVu Sans", fontsize=11];
  subgraph cluster_before { label="Раньше"; color="#aab5a4"; oldchat [label="Основное окно чата"]; oldowner [label="Отдельное окно настроек"]; oldchat -> oldowner; }
  subgraph cluster_after { label="Теперь"; color="#527244"; subgraph cluster_window { label="Основное окно чата"; chat [label="Контекст чата\nПереписка и черновик"]; owner [label="Контекст настроек\nAPI владельца + отдельная partition"]; owner -> chat [label="Назад к чату\nУничтожить контекст настроек"]; } }
  vault [label="Собственный runtime / Vault\nПрежние проверки IPC"]; oldowner -> vault; owner -> vault; oldchat -> chat [style=dashed, label=" "];
}
