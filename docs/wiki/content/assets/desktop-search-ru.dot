digraph Search { graph [rankdir=TB,bgcolor="#111a17",pad="0.3",nodesep="0.35",ranksep="0.4",fontname="DejaVu Sans",fontcolor="#e6eddf",label="Поиск в Desktop: до и после",labelloc=t,fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#243329",color="#6a865e",fontname="DejaVu Sans",fontcolor="#edf2e7",fontsize=15,margin="0.2,0.12"]; edge [color="#b6df87",arrowsize=0.8];
subgraph cluster_before { label="До";color="#745c54";old [label="Импорт профиля Desktop"];model [label="Только подключение модели"];missing [label="Ключ поиска не подключён",color="#bc8874"];old -> model;model -> missing [style=dashed,arrowhead=none];}
subgraph cluster_after { label="После";color="#718b63";settings [label="Настройки Desktop: выбрать и проверить"];vault [label="Зашифрованное Desktop-хранилище"];bridge [label="Поиск с доступом от владельца"];provider [label="Tavily / Exa / Serper"];result [label="Модель получает результаты, а не ключ"];settings -> vault -> bridge -> provider -> result;}
missing -> settings [style=invis];cli [label="CLI-хранилище"];cli_search [label="CLI-поиск (без изменений)"];cli -> cli_search;result -> cli [style=invis];footer [shape=plaintext,fillcolor="#111a17",label="Ключ сохраняется; служба выбирается явно"];cli_search -> footer [style=invis];}
