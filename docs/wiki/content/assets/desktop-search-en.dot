digraph Search { graph [rankdir=TB,bgcolor="#111a17",pad="0.3",nodesep="0.35",ranksep="0.4",fontname="DejaVu Sans",fontcolor="#e6eddf",label="Desktop search: before and after",labelloc=t,fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#243329",color="#6a865e",fontname="DejaVu Sans",fontcolor="#edf2e7",fontsize=15,margin="0.2,0.12"]; edge [color="#b6df87",arrowsize=0.8];
subgraph cluster_before { label="Before";color="#745c54";old [label="Desktop profile import"];model [label="Model connection only"];missing [label="Search key not connected",color="#bc8874"];old -> model;model -> missing [style=dashed,arrowhead=none];}
subgraph cluster_after { label="After";color="#718b63";settings [label="Desktop settings: choose and check"];vault [label="Encrypted Desktop Vault"];bridge [label="Owner-scoped search bridge"];provider [label="Tavily / Exa / Serper"];result [label="Model receives results, never the key"];settings -> vault -> bridge -> provider -> result;}
missing -> settings [style=invis];cli [label="CLI Vault"];cli_search [label="CLI search (unchanged)"];cli -> cli_search;result -> cli [style=invis];footer [shape=plaintext,fillcolor="#111a17",label="Key stored once; explicit switching; no silent fallback"];cli_search -> footer [style=invis];}
